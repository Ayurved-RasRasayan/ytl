# =============================================================================
# AUTHENTICATION CONFIGURATION (REQUIRED)
# =============================================================================
# You MUST set these values before starting the server!
# Copy this file to .env and fill in your credentials.

ADMIN_USERNAME=your_username_here
ADMIN_PASSWORD=your_secure_password_here
SESSION_SECRET=random_long_secret_string_at_least_32_characters_long

# Server Configuration
PORT=3000

# Optional: Cookie file path for YouTube authentication
COOKIE_FILE_PATH=cookies.txt

# Optional: Browser name for cookie extraction (edge, chrome, firefox, safari)
BROWSER_NAME=edge
